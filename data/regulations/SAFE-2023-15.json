  "practicalGuidance": {
    "commonScenarios": [
      {
        "scenario": "个人购汇",
        "applicableArticles": [{"chapterNumber": 2, "articleNumber": 5}],
        "procedureSteps": [
          "1. 准备有效身份证件",
          "2. 登录银行网银或前往银行柜台",
          "3. 选择购汇业务，输入购汇金额",
          "4. 如金额超过5万美元，准备并提交交易真实性证明材料",
          "5. 完成购汇交易"
        ],
        "commonIssues": [
          {
            "issue": "超额购汇被拒",
            "solution": "准备完整的交易真实性证明材料，如留学录取通知书、学费单等"
          },
          {
            "issue": "不知道哪些材料可作为真实性证明",
            "solution": "咨询银行工作人员，一般包括交易合同、发票、订单等能证明交易真实性的文件"
          }
        ]
      },
      {
        "scenario": "境外投资",
        "applicableArticles": [{"chapterNumber": 3, "articleNumber": 10}],
        "procedureSteps": [
          "1. 准备境外投资相关材料，如投资协议、境外公司注册文件等",
          "2. 向外汇局申请办理境外直接投资外汇登记",
          "3. 获得外汇局批准后，前往银行办理资金汇出手续",
          "4. 完成境外投资"
        ],
        "commonIssues": [
          {
            "issue": "登记材料不完整",
            "solution": "按照外汇局要求，准备完整的投资协议、境外公司注册文件等材料"
          },
          {
            "issue": "投资金额较大",
            "solution": "可能需要提供更详细的投资计划和资金来源证明"
          }
        ]
      }
    ],
